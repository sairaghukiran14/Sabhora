# Copy to .env and fill in. Never commit .env.
ENV=dev
LOG_LEVEL=INFO

# Who plays the personas (many calls): fake | sarvam | anthropic
LLM_PROVIDER=fake
# Who writes verdicts (few calls, must be reliable): fake | anthropic | sarvam
JUDGE_PROVIDER=fake

# Paste your key(s) here. Only the provider(s) you selected above need one.
SARVAM_API_KEY=
# Persona model on Sarvam. Tested options (see scripts/model_bakeoff.py):
#   sarvam-105b-conversations (recommended), sarvam-105b,
#   glm5.3-flash, gemma4, deepseekv4.1-flash-1017, glm5.3
# Endpoint (/v1 or /v2) and thinking defaults are picked per model automatically.
SARVAM_MODEL=sarvam-105b-conversations
# Optional override: none | low | high | max (empty = the model's own default)
SARVAM_REASONING_EFFORT=
# Optional mixed Janta crowd, e.g. sarvam-105b-conversations,glm5.3-flash
# (each person keeps one model; adds a "By model" breakdown). Off by default: in testing
# it did not make votes less label-driven (scripts/crowd_label_test.py).
JANTA_MODELS=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Thinking depth for Claude: low | medium | high (low = faster, cheaper persona turns)
ANTHROPIC_EFFORT=low

# Saved debates. Use the same database as web/.env.local. Empty = JSON files in ./data
# Create the tables first: cd ../web && npm run db:migrate
DATABASE_URL=postgresql://127.0.0.1:5432/pitch_panchayat

# Voice for Sharks. fake = free placeholder sound and text (offered only with the demo AI).
# sarvam = real speech on SARVAM_API_KEY, BILLED (about Rs 2 per 1,000 spoken characters).
VOICE_PROVIDER=fake
VOICE_MAX_CHARS_PER_DEBATE=10000

# Cost caps (tokens)
MAX_TOKENS_PER_DEBATE=60000
JUDGE_RESERVE_TOKENS=30000
# Sharks only: separate cap for offers, bidding and your counter
DEAL_RESERVE_TOKENS=25000
DAILY_TOKEN_LIMIT=600000

# Debate shape
SHARK_ROUNDS=3
FOUNDER_WAIT_S=45
# Time to accept, counter or walk away once offers are in
DEAL_WAIT_S=90
JANTA_SIZE=50
JANTA_MAX_SIZE=1000
JANTA_ROUNDS=2
# Show each crowd member's attitude label ("early adopter"...) to the model. Off by default:
# shown, the label decided most votes (docs/05, reports/ section 13).
JANTA_SHOW_ATTITUDE=false

RATE_LIMIT_PER_HOUR=30

# Shared secret with the web app (web/.env.local BACKEND_API_TOKEN). When set, only a caller
# that sends it can start or read runs; the old single-page prototype at / then stops working.
# Required when ENV=prod. Generate one with: openssl rand -hex 32
INTERNAL_API_TOKEN=
