# Copy to .env.local and fill in. Never commit .env.local.

# Signs sessions and encrypts stored API keys. Generate with: openssl rand -hex 32
# Changing it makes saved API keys unreadable.
AUTH_SECRET=

# Postgres. Create the database, then the tables:  createdb pitch_panchayat && npm run db:migrate
DATABASE_URL=postgresql://127.0.0.1:5432/pitch_panchayat

# The FastAPI engine, and the shared secret (backend/.env INTERNAL_API_TOKEN)
BACKEND_URL=http://127.0.0.1:8000
BACKEND_API_TOKEN=
